---
import { content } from '../data/content';
import MagneticButton from './MagneticButton.astro';

const { cta } = content;
---

<section id="contacto" class="py-28 md:py-40 bg-clay-50 relative overflow-hidden">
  <!-- Ambient decorative background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-96 h-96 bg-inka-gold/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-inka-purple/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 text-center md:text-left">
    <div class="max-w-4xl mx-auto md:mx-0">
      <p class="text-inka-gold text-sm uppercase tracking-[0.2em] font-medium mb-3">Contacto</p>
      <h2
        data-cta-heading
        class="text-clay-950 font-display font-bold text-5xl md:text-7xl lg:text-8xl leading-[1.05] tracking-tight mb-6"
      >
        {cta.heading}
      </h2>
      <p
        data-cta-subcopy
        class="text-clay-700 text-lg md:text-xl max-w-2xl mb-10 leading-relaxed"
      >
        {cta.subCopy}
      </p>
      <div class="flex flex-wrap gap-4 items-center justify-center md:justify-start">
        <div data-cta-button>
          <MagneticButton cta={cta.primaryCta} variant="primary" icon="arrow-right" size="large" />
        </div>
        {cta.secondaryCta && (
          <div data-cta-button>
            <MagneticButton cta={cta.secondaryCta} variant="secondary" icon="arrow-up-right" size="large" />
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import { animateCta } from '../scripts/anim-cta';

  const section = document.getElementById('contacto');
  animateCta(section);
</script>
