---
import { content } from '../data/content';

const { footer } = content;
---

<footer class="bg-clay-950 text-clay-400">
  <!-- Hairline separator -->
  <div class="h-px bg-clay-800/50 mx-6 md:mx-12"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 py-14 md:py-18">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
      <!-- Brand -->
      <div>
        <h3 class="text-clay-100 font-display font-bold text-lg mb-2">{footer.brandName}</h3>
        <p class="text-clay-500 text-sm">{footer.tagline}</p>
      </div>

      <!-- Navigation -->
      <div>
        <p class="text-clay-200 text-sm font-medium uppercase tracking-wider mb-4">Navegación</p>
        <ul class="space-y-2">
          {footer.navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-clay-400 hover:text-clay-100 transition-colors duration-300 text-sm"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & Social -->
      <div>
        <p class="text-clay-200 text-sm font-medium uppercase tracking-wider mb-4">Contacto</p>
        {footer.contact.email && (
          <p class="text-sm mb-1">
            <a href={`mailto:${footer.contact.email}`} class="text-clay-400 hover:text-clay-100 transition-colors duration-300">
              {footer.contact.email}
            </a>
          </p>
        )}
        {footer.contact.phone && (
          <p class="text-sm mb-4">{footer.contact.phone}</p>
        )}

        <div class="flex gap-4 mt-4">
          {footer.socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-clay-800/50 flex items-center justify-center hover:bg-inka-gold/20 hover:text-inka-gold transition-all duration-300"
              aria-label={link.platform}
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {link.platform === 'Instagram' && (
                  <>
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </>
                )}
                {link.platform === 'WhatsApp' && (
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                )}
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-clay-800/30 mt-10 pt-8 text-center">
      <p class="text-clay-600 text-xs">{footer.copyright}</p>
    </div>
  </div>
</footer>
