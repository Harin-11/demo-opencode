---
import { content } from '../data/content';
import type { FeatureCard } from '../data/types';

const { cards } = content.features;

/**
 * Returns Tailwind grid column/row span classes based on card size
 */
function sizeClasses(size: FeatureCard['size']): string {
  switch (size) {
    case 'wide':   return 'md:col-span-2';
    case 'tall':   return 'md:row-span-2';
    case 'large':  return 'md:col-span-2 md:row-span-2';
    default:       return '';
  }
}
---

<span id="itinerarios" class="block" aria-hidden="true"></span>

<section id="experiencias" class="py-24 md:py-32 bg-clay-50">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Section header -->
    <div class="mb-12 md:mb-16 max-w-3xl">
      <p class="text-inka-gold text-sm uppercase tracking-[0.2em] font-medium mb-3">Experiencias</p>
      <h2 class="text-clay-950 font-display font-bold text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
        Viví la <span class="text-inka-gold">cordillera</span> en cada paso
      </h2>
    </div>

    <!-- Bento grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:grid-flow-dense">
      {cards.map((card) => (
        <div
          data-feature-card
          class={`${sizeClasses(card.size)}`}
        >
          <div class="p-1.5 rounded-[2rem] bg-clay-200/60 border border-clay-200 h-full group cursor-pointer transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-[1.02]">
            <div class="rounded-[calc(2rem-0.375rem)] bg-clay-50 shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)] h-full overflow-hidden">
              {card.variant === 'image' && card.image && (
                <div class="relative h-full min-h-[280px]">
                  <img
                    src={card.image.src}
                    alt={card.image.alt}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-clay-950/70 via-clay-950/20 to-transparent"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                    <h3 class="text-clay-50 font-display font-bold text-xl md:text-2xl mb-2">{card.title}</h3>
                    <p class="text-clay-300 text-sm md:text-base leading-relaxed max-w-md">{card.description}</p>
                  </div>
                </div>
              )}

              {(card.variant === 'text' || card.variant === 'icon') && (
                <div class="p-6 md:p-8 flex flex-col justify-center h-full">
                  {card.variant === 'icon' && (
                    <div class="w-12 h-12 rounded-full bg-inka-gold/10 flex items-center justify-center mb-4">
                      <svg class="w-6 h-6 text-inka-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      </svg>
                    </div>
                  )}
                  <h3 class="text-clay-950 font-display font-bold text-xl md:text-2xl mb-2">{card.title}</h3>
                  <p class="text-clay-700 text-sm md:text-base leading-relaxed">{card.description}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { animateFeatures } from '../scripts/anim-features';

  const section = document.getElementById('experiencias');
  animateFeatures(section);
</script>
